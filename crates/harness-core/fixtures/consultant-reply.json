[
  {
    "op": "add_decide",
    "id": "classify",
    "reads": ["ticket"],
    "questions": {
      "route": {
        "kind": "choice",
        "instructions": "Which team should handle this support ticket?",
        "criteria": {
          "billing": "Charges, refunds, invoices, and payment methods."
        }
      }
    },
    "policy": { "min_confidence": 0.7, "on_low": "safe_default" }
  },
  {
    "op": "connect",
    "from": "classify",
    "when": { "kind": "label", "question": "route", "equals": "billing" },
    "to": "billing"
  },
  {
    "op": "set_low",
    "action": "safe_default",
    "to": "queue"
  }
]
