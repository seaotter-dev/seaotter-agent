{
  "owner": "fixture",
  "tier": "read",
  "grants": [],
  "start": "gate",
  "nodes": [
    {
      "kind": "decide",
      "id": "gate",
      "reads": ["request"],
      "questions": {
        "allow": {
          "kind": "noul",
          "instructions": "Is it safe to draft a reply to this request?"
        }
      },
      "policy": {
        "min_confidence": 0.7,
        "on_low": "safe_default"
      }
    },
    {
      "kind": "generate",
      "id": "draft",
      "task": "Draft a short reply to this support request.",
      "reads": ["request"],
      "output": {
        "schema": {
          "type": "object",
          "required": ["reply"],
          "properties": {
            "reply": { "type": "string" }
          }
        }
      },
      "max_tokens": 128,
      "gate": {
        "decide": "gate",
        "question": "allow",
        "allow": "true"
      }
    }
  ],
  "edges": [
    {
      "from": "gate",
      "when": { "kind": "state", "key": "approved", "equals": true },
      "to": "draft"
    },
    {
      "from": "gate",
      "when": { "kind": "state", "key": "approved", "equals": false },
      "to": "safe"
    },
    {
      "from": "draft",
      "when": { "kind": "generated" },
      "to": "accept"
    },
    {
      "from": "draft",
      "when": { "kind": "skipped" },
      "to": "safe"
    }
  ],
  "on_low": {
    "safe_default": "safe"
  }
}
